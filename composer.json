{
    "name": "tachyon/filament-media-library",
    "description": "Filament Curator için klasör gezintili, kullanım takipli ve güvenli silmeli medya kütüphanesi eklentisi.",
    "keywords": ["laravel", "filament", "curator", "media", "media-library"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^12.0|^13.0",
        "filament/filament": "^5.0",
        "awcodes/filament-curator": "^5.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Tachyon\\MediaLibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tachyon\\MediaLibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tachyon\\MediaLibrary\\MediaLibraryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
